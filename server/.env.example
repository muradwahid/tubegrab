# Port the API listens on
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Maximum number of videos accepted from a single playlist
MAX_PLAYLIST_SIZE=100
# Where per-job temp folders are created (relative to /server or absolute)
DOWNLOAD_DIR=./downloads
# Optional overrides for binaries (default: resolved from PATH)
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Minutes to keep finished files before deletion
FILE_TTL_MINUTES=30
# Requests per minute per IP for the rate-limited endpoints
RATE_LIMIT_PER_MINUTE=10
# Set to 1 when running behind a reverse proxy (Render, Railway, nginx)
TRUST_PROXY=0
# Seconds after which a progress stream is closed and the browser reconnects
# (keeps requests under Vercel's 300s limit). 0 = never.
SSE_MAX_SECONDS=270
# Optional — helps on cloud hosts where YouTube asks "confirm you're not a bot":
# YTDLP_COOKIES=<contents of a Netscape cookies.txt, or base64 of it>
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_CLIENT_FALLBACK=default,tv_embedded,web_embedded,android_vr,mweb,tv_simply,android
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv_simply,mweb
